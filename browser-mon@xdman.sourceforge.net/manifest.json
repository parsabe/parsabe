{
  "manifest_version": 3,
  "name": "XDM Browser Monitor",
  "description": "XDM integration module for Chromium",
  "version": "2.2",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png"
    },
    "default_title": "XDM Browser Monitor"
  },
  "permissions": [
    "tabs",
    "cookies",
    "contextMenus",
    "activeTab",
    "webRequest",
    "storage",
    "downloads",
    "scripting",
    "management",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-monitoring": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle monitoring"
    }
  }
}
